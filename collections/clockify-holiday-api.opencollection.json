        {
          "info": {
            "name": "Get holidays on a workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/workspaces/:workspaceId/holidays",
            "params": [
              {
                "name": "workspaceId",
                "value": "60f91b3ffdaf031696ec61a8",
                "type": "path",
                "description": "Represents a workspace identifier across the system."
              },
              {
                "name": "assigned-to",
                "value": "60f924bafdaf031696ec6218",
                "type": "query",
                "description": "If provided, you'll get a filtered list of holidays assigned to user."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get holidays on a workspace"
