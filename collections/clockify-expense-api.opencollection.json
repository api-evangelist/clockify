                "description": "Represents a workspace identifier across the system."
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "page-size",
                "value": "50",
                "type": "query",
                "description": "Page size."
              },
              {
