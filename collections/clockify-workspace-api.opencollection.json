          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/workspaces/:workspaceId/users/:userId/cost-rate",
            "params": [
              {
                "name": "workspaceId",
                "value": "64a687e29ae1f428e7ebe303",
