              },
              {
                "name": "page-size",
                "value": "50",
                "type": "query",
                "description": "Page size."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Find user's team manager"
        },
        {
