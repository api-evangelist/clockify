            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-marketplace-token",
              "value": "{{x-marketplace-token}}",
              "placement": "header"
            }
          },
          "docs": "Filter workspace users"
        },
        {
