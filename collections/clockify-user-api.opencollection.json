              },
              {
                "name": "customFieldId",
                "value": "5e4117fe8c625f38930d57b7",
                "type": "path",
                "description": "Represents custom field identifier across the system."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Update a user's custom field"
