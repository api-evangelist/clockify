                "description": "Represents a workspace identifier across the system."
              },
              {
                "name": "userId",
                "value": "89b687e29ae1f428e7ebe912",
                "type": "path",
                "description": "Represents a user identifier across the system."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint is not functional and has been deprecated. A user can be removed/deleted on the CAKE.com Account Members page after deactivating all their existing memberships on all workspaces within an organization."
